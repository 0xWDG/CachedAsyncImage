"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This view uses the shared","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URLSession","type":"text"},{"text":" ","type":"text"},{"text":"instance to load an image from the specified URL, and then display it.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can display an icon that’s stored on a server:","type":"text"}]},{"code":["CachedAsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\"))","    .frame(width: 200, height: 200)"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Until the image loads, the view displays a standard placeholder that"},{"type":"text","text":" "},{"type":"text","text":"fills the available space. After the load completes successfully, the view"},{"type":"text","text":" "},{"type":"text","text":"updates to display the image. In the example above, the icon is smaller"},{"type":"text","text":" "},{"type":"text","text":"than the frame, and so appears smaller than the placeholder."}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"text":"You can specify a custom placeholder using","type":"text"},{"text":" ","type":"text"},{"code":"init(url:scale:content:placeholder:)","type":"codeVoice"},{"text":". With this initializer, you can","type":"text"},{"text":" ","type":"text"},{"text":"also use the ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" parameter to manipulate the loaded image.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can add a modifier to make the loaded image resizable:","type":"text"}]},{"code":["CachedAsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}",".frame(width: 50, height: 50)"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For this example, SwiftUI shows a "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" first, and then the"},{"type":"text","text":" "},{"type":"text","text":"image scaled to fit in the specified frame:"}]},{"type":"paragraph","inlineContent":[]},{"name":"Important","content":[{"inlineContent":[{"text":"You can’t apply image-specific modifiers, like","type":"text"},{"text":" ","type":"text"},{"code":"Image\/resizable(capInsets:resizingMode:)","type":"codeVoice"},{"text":", directly to an ","type":"text"},{"code":"AsyncImage","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Instead, apply them to the ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" instance that your ","type":"text"},{"code":"content","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure gets when defining the view’s appearance."}],"type":"paragraph"}],"style":"important","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"To gain more control over the loading process, use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init(url:scale:transaction:content:)"},{"text":" initializer, which takes a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" closure that receives an ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase"},{"text":" to indicate","type":"text"},{"text":" ","type":"text"},{"text":"the state of the loading operation. Return a view that’s appropriate","type":"text"},{"text":" ","type":"text"},{"text":"for the current phase:","type":"text"}]},{"code":["CachedAsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { phase in","    if let image = phase.image {","        image \/\/ Displays the loaded image.","    } else if phase.error != nil {","        Color.red \/\/ Indicates an error.","    } else {","        Color.blue \/\/ Acts as a placeholder.","    }","}"],"syntax":null,"type":"codeListing"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/init(url:urlCache:scale:)","doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/init(url:urlCache:scale:content:placeholder:)","doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/init(url:urlCache:scale:transaction:content:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"references":{"doc://CachedAsyncImage/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/CachedAsyncImage\/s8SendableP","type":"unresolvable"},"doc://CachedAsyncImage/documentation/CachedAsyncImage/CachedAsyncImage/init(url:urlCache:scale:transaction:content:)":{"kind":"symbol","abstract":[{"type":"text","text":"Loads and displays a modifiable image from the specified URL in phases."}],"type":"topic","role":"symbol","url":"\/documentation\/cachedasyncimage\/cachedasyncimage\/init(url:urlcache:scale:transaction:content:)","identifier":"doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/init(url:urlCache:scale:transaction:content:)","title":"init(url:urlCache:scale:transaction:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"url","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"te