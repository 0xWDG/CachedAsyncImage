nd"},{"type":"text","text":" "},{"type":"text","text":"returns the view to show. You can return the image directly, or"},{"type":"text","text":" "},{"type":"text","text":"modify it as needed before returning it."}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that returns the view to show until the"},{"type":"text","text":" "},{"type":"text","text":"load operation completes successfully."}]}],"name":"placeholder"}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Until the image loads, SwiftUI displays the placeholder view that"},{"type":"text","text":" "},{"type":"text","text":"you specify. When the load operation completes successfully, SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"updates the view to show content that you specify, which you"},{"type":"text","text":" "},{"type":"text","text":"create using the loaded image. For example, you can show a green"},{"type":"text","text":" "},{"type":"text","text":"placeholder, followed by a tiled version of the loaded image:"}],"type":"paragraph"},{"code":["CachedAsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { image in","    image.resizable(resizingMode: .tile)","} placeholder: {","    Color.green","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"If the load operation fails, SwiftUI continues to display the"},{"type":"text","text":" "},{"type":"text","text":"placeholder. To be able to display a different view on a load error,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"codeVoice","code":"init(url:scale:transaction:content:)"},{"type":"text","text":" initializer instead."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage","doc:\/\/CachedAsyncImage\/documentation\/C