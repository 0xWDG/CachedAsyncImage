":")"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"url","content":[{"inlineContent":[{"type":"text","text":"The URL of the image to display."}],"type":"paragraph"}]},{"name":"urlCache","content":[{"inlineContent":[{"text":"The URL cache for providing cached responses to requests within the session.","type":"text"}],"type":"paragraph"}]},{"name":"scale","content":[{"inlineContent":[{"type":"text","text":"The scale to use for the image. The default is "},{"code":"1","type":"codeVoice"},{"type":"text","text":". Set a"},{"type":"text","text":" "},{"type":"text","text":"different value when loading images designed for higher resolution"},{"type":"text","text":" "},{"type":"text","text":"displays. For example, set a value of "},{"code":"2","type":"codeVoice"},{"type":"text","text":" for an image that you"},{"type":"text","text":" "},{"type":"text","text":"would name with the "},{"code":"@2x","type":"codeVoice"},{"type":"text","text":" suffix if stored in a file on disk."}],"type":"paragraph"}]},{"name":"transaction","content":[{"type":"paragraph","inlineContent":[{"text":"The transaction to use when the phase changes.","type":"text"}]}]},{"name":"content","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes the load phase as an input, and"},{"type":"text","text":" "},{"type":"text","text":"returns the view to display for the specified phase."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"If you set the asynchronous image’s URL to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", or after you set the","type":"text"},{"text":" ","type":"text"},{"text":"URL to a value but before the load operation completes, the phase is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase\/empty"},{"text":". After the operation completes, the phase","type":"text"},{"text":" ","type":"text"},{"text":"becomes either ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase\/failure(_:)"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase\/success(_:)"},{"text":". In the first case, the phase’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase\/error"},{"text":" value indicates the reason for failure.","type":"text"},{"text":" ","type":"text"},{"text":"In the second case, the phase’s ","type":"text"},{"type":"codeVoice","code":"AsyncImagePhase\/image"},{"text":" property","type":"text"},{"text":" ","type":"text"},{"text":"contains the loaded image. Use the phase to drive the output of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" closure, which defines the view’s appearance:","type":"text"}]},{"code":["CachedAsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { phase in","    if let image = phase.image {","        image \/\/ Displays the loaded image.","    } else if phase.error != nil {","        Color.red \/\/ Indicates an error.","    } else {","        Color.blue \/\/ Acts as a placeholder.","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add transitions when you change the URL, apply an identifier to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncImage"},{"type":"text","text":"."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CachedAsyncImage\/documentation\/CachedAsyncImage\/CachedAsyncImage\/init(url:urlCache:scale:transaction:content:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Initializer","role":"symbol","modules":[{"name":"CachedAsyncImage"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Founda